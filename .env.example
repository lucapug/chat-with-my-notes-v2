# LLM — Ollama Generation (primary RAG model)
OLLAMA_GENERATION_URL=http://YOUR_GENERATOR_HOST:11434/v1
OLLAMA_GENERATION_MODEL=YOUR_GENERATION_MODEL

# LLM — Ollama Judge (BRF translation + query expansion)
OLLAMA_JUDGE_URL=http://YOUR_JUDGE_HOST:11434/v1
OLLAMA_JUDGE_MODEL=YOUR_JUDGE_MODEL

# Search index
VAULT_INDEX_PATH=data/vault_index.pkl

# Data sources (Notion export dir)
VAULT_NOTION_DIR=data/notion
VAULT_PAGES_MAP=data/notion_pages_map.json

# Embedding (Ollama /embeddings endpoint)
OLLAMA_EMBED_URL=http://YOUR_EMBED_HOST:11434/v1
EMBED_MODEL=YOUR_EMBED_MODEL
SEMANTIC_INDEX_PATH=data/semantic_index.pkl

# API
APP_PORT=8000
LOG_LEVEL=INFO
